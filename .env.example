JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
MYSQL_ROOT_PASSWORD=replace-root-password
DB_PASSWORD=replace-application-password
ADMIN_PASSWORD=replace-admin-password
CAJERO_PASSWORD=replace-cajero-password
ALMACEN_PASSWORD=replace-almacen-password
CONFIG_SERVER_PASSWORD=replace-config-password
